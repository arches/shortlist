source "https://rubygems.org"

gem "rails", "~> 8.1.4"
gem "pg", "~> 1.1"
gem "puma", ">= 5.0"

# Password hashing, through has_secure_password.
gem "bcrypt", "~> 3.1.7"

# Access token signing and verification. HS256, keyed on SECRET_KEY_BASE.
gem "jwt", "~> 3.1"

# shortlist.stack.md names aws-sdk-s3 as the S3 client, for Tigris: Fly's
# S3-compatible object storage, where shortlist.deployment.md puts the database
# backups. The S3 API and its tooling apply; the bucket is not in AWS.
gem "aws-sdk-s3", "~> 1.0"

gem "tzinfo-data", platforms: %i[ windows jruby ]

# Reduces boot times through caching; required in config/boot.rb
gem "bootsnap", require: false

group :development, :test do
  gem "debug", platforms: %i[ mri windows ], require: "debug/prelude"

  # Omakase Ruby styling [https://github.com/rails/rubocop-rails-omakase/]
  gem "rubocop-rails-omakase", require: false
end

group :test do
  gem "rspec-rails", "~> 8.0"
  gem "factory_bot_rails", "~> 6.4"

  # HTTP stubbing, per shortlist.stack.md. Nothing in the suite reaches Google.
  gem "webmock", "~> 3.25"
end

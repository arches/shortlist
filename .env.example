# Local development values. `make` copies this to .env the first time it needs
# one; .env itself is never committed.
#
# shortlist.stack.md: a variable keeps the name Rails or a library already reads
# it under, and anything Shortlist invents for itself takes a SHORTLIST_ prefix.
# Nothing here is Shortlist's own invention yet.

RAILS_ENV=development

POSTGRES_USER=shortlist
POSTGRES_PASSWORD=shortlist
POSTGRES_DB=shortlist_development

DATABASE_URL=postgres://shortlist:shortlist@db:5432/shortlist_development

# Signs and verifies access tokens (HS256). Any long random string locally.
SECRET_KEY_BASE=c0ffee_development_secret_key_base_not_for_anything_that_matters

# Local development values. `make` copies this to .env the first time it needs
# one; .env itself is never committed.
#
# shortlist.stack.md: a variable keeps the name Rails or a library already reads
# it under, and anything Shortlist invents for itself takes a SHORTLIST_ prefix.
# Both kinds are below, and the prefix is how they are told apart by sight.

RAILS_ENV=development

# Where the stack is published on the host. Shortlist's own variables, so they
# carry the prefix. Change them if another project on this machine has the port.
SHORTLIST_API_PORT=3000
SHORTLIST_FRONTEND_PORT=5173
SHORTLIST_DB_PORT=5432

POSTGRES_USER=shortlist
POSTGRES_PASSWORD=shortlist
POSTGRES_DB=shortlist_development

DATABASE_URL=postgres://shortlist:shortlist@db:5432/shortlist_development

# `make test` passes this to the container as DATABASE_URL, so the suite never
# touches the development database. Shortlist's own variable, hence the prefix.
SHORTLIST_TEST_DATABASE_URL=postgres://shortlist:shortlist@db:5432/shortlist_test

# shortlist.stack.md: the Google Places key is server-side configuration, called
# by the API and never by the browser. Shortlist's own variable, hence the
# prefix. Adding a restaurant needs a real key; the test suite stubs every call.
SHORTLIST_GOOGLE_PLACES_API_KEY=replace-me-with-a-google-places-api-key

# shortlist.stack.md puts Maps on the frontend, and the Maps JS API runs in the
# browser — so unlike the Places key above, this one reaches the browser. It
# gets there through GET /api/configuration, because
# shortlist.principles.md keeps configuration out of the bundle. Two separate
# keys: restrict this one to the Maps JavaScript API and to your own origins.
# The map needs a real key; no test does.
SHORTLIST_GOOGLE_MAPS_API_KEY=replace-me-with-a-google-maps-api-key

# Signs and verifies access tokens (HS256). Any long random string locally.
SECRET_KEY_BASE=c0ffee_development_secret_key_base_not_for_anything_that_matters
